NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Required for account deletion; never use a NEXT_PUBLIC_ name.
SUPABASE_SECRET_KEY=

# Opt in separately for each deployment environment. Production stays disabled.
BUG_REPORTS_ENABLED=false
BUG_REPORT_GITHUB_REPOSITORY=zenzontle/garage-guardian
BUG_REPORT_GITHUB_TOKEN=
# At least 32 random characters; keep stable to preserve reporter pseudonyms.
BUG_REPORT_HMAC_SECRET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional overrides; otherwise use VERCEL_ENV and package version + commit SHA.
BUG_REPORT_ENVIRONMENT=
BUG_REPORT_RELEASE=

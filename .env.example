NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Used by optional weekly reminders; never use a NEXT_PUBLIC_ name.
SUPABASE_SECRET_KEY=

# Weekly account reminders: keep disabled until staging verification is complete.
REMINDERS_ENABLED=false
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
CRON_SECRET=
# Exact public HTTPS origin (no path, query, credentials, or fragment).
REMINDER_APP_ORIGIN=

# Opt in separately for each deployment environment. Production stays disabled.
FEEDBACK_ENABLED=false
# Linear API key restricted to one team (Read + Create issues), and that team's UUID.
# Preview uses the Feedback test (FBT) team; Production uses Feedback (FB).
FEEDBACK_LINEAR_API_KEY=
FEEDBACK_LINEAR_TEAM_ID=
# At least 32 random characters; keep stable to preserve reporter pseudonyms.
FEEDBACK_HMAC_SECRET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional overrides; otherwise use VERCEL_ENV and package version + commit SHA.
FEEDBACK_ENVIRONMENT=
FEEDBACK_RELEASE=
